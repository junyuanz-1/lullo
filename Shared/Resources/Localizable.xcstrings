    "Sex is used for WHO growth percentiles.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Geschlecht wird für die WHO-Perzentilen verwendet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sex is used for WHO growth percentiles."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El sexo se usa para calcular los percentiles de crecimiento de la OMS."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le sexe sert au calcul des percentiles de croissance de l’OMS."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "性別はWHO成長パーセンタイルの計算に使用されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "성별은 WHO 성장 백분위 계산에 사용돼요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O sexo é usado para os percentis de crescimento da OMS."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "性别用于计算 WHO 生长百分位。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "性別用於計算 WHO 生長百分位。"
          }
        }
      }
    },
    "Shaded bands show the 3rd–97th and 15th–85th percentiles of the WHO Child Growth Standards (birth to 24 months).": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die schattierten Bereiche zeigen die 3.–97. und 15.–85. Perzentile der WHO-Wachstumsstandards für Kinder (Geburt bis 24 Monate)."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shaded bands show the 3rd–97th and 15th–85th percentiles of the WHO Child Growth Standards (birth to 24 months)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las franjas sombreadas muestran los percentiles 3–97 y 15–85 de los Patrones de Crecimiento Infantil de la OMS (del nacimiento a los 24 meses)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les zones ombrées représentent les 3e–97e et 15e–85e percentiles des normes de croissance de l’enfant de l’OMS (de la naissance à 24 mois)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "網掛けの帯は、WHOの子どもの成長基準（0〜24か月）の3〜97パーセンタイルと15〜85パーセンタイルの範囲を示しています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "음영 영역은 WHO 아동 성장 표준(출생~24개월)의 3–97백분위와 15–85백분위를 나타내요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As faixas sombreadas mostram os percentis 3–97 e 15–85 dos Padrões de Crescimento Infantil da OMS (do nascimento aos 24 meses)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "阴影区域为 WHO 儿童生长标准（0–24 个月）的第 3–97 和第 15–85 百分位。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "陰影區域為 WHO 兒童生長標準（出生至 24 個月）的第 3–97 及第 15–85 百分位。"
          }
        }
      }
    },
