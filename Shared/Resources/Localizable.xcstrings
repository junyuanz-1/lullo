    "Newborns usually have 6 or more wet diapers a day after the first week.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nach der ersten Woche haben Neugeborene meist 6 oder mehr nasse Windeln pro Tag."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Newborns usually have 6 or more wet diapers a day after the first week."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "A partir de la primera semana, los recién nacidos suelen mojar 6 o más pañales al día."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Après la première semaine, un nouveau-né a généralement 6 couches mouillées ou plus par jour."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "生後1週間を過ぎた新生児は、通常1日に6回以上おしっこでおむつが濡れます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "신생아는 생후 첫 주가 지나면 보통 하루에 소변 기저귀가 6개 이상 나와요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Após a primeira semana, recém-nascidos costumam ter 6 ou mais fraldas molhadas por dia."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "新生儿满一周后通常每天有 6 片或更多湿尿布。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "新生兒滿一週後，通常每天會有 6 片以上的濕尿布。"
          }
        }
      }
    },
