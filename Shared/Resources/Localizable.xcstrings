    "Track sleep, feeds, diapers and growth. Everything syncs privately through your iCloud and can be shared with family.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erfasse Schlaf, Mahlzeiten, Windeln und Wachstum. Alles wird privat über deine iCloud synchronisiert und lässt sich mit der Familie teilen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Track sleep, feeds, diapers and growth. Everything syncs privately through your iCloud and can be shared with family."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Registra el sueño, las tomas, los pañales y el crecimiento. Todo se sincroniza de forma privada con tu iCloud y puedes compartirlo con tu familia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Suivez le sommeil, les repas, les couches et la croissance. Tout se synchronise en privé via votre iCloud et peut être partagé avec la famille."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "睡眠、授乳、おむつ、成長を記録できます。データはあなたのiCloudを通じてプライベートに同期され、家族と共有することもできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "수면, 수유, 기저귀, 성장을 기록하세요. 모든 데이터는 내 iCloud를 통해 비공개로 동기화되고 가족과 공유할 수 있어요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Registre sono, mamadas, fraldas e crescimento. Tudo é sincronizado de forma privada pelo seu iCloud e pode ser compartilhado com a família."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "记录睡眠、喂养、尿布和生长。所有数据通过你的 iCloud 私密同步，并可与家人共享。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "記錄睡眠、餵奶、尿布和成長。所有資料都透過你的 iCloud 私密同步，也能與家人共享。"
          }
        }
      }
    },
