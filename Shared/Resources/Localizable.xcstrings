    "This is a fever. Call your doctor if your baby seems unwell, the fever lasts more than a day, or you are worried.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das ist Fieber. Ruf einen Arzt an, wenn dein Baby krank wirkt, das Fieber länger als einen Tag anhält oder du dir Sorgen machst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This is a fever. Call your doctor if your baby seems unwell, the fever lasts more than a day, or you are worried."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto es fiebre. Llama a tu médico si tu bebé no se ve bien, si la fiebre dura más de un día o si algo te preocupa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "C’est de la fièvre. Appelez votre médecin si votre bébé semble mal en point, si la fièvre dure plus d’un jour ou en cas d’inquiétude."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "発熱しています。赤ちゃんの具合が悪そうなとき、熱が1日以上続くとき、または心配なときは医師に連絡してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "열이 있어요. 아기가 아파 보이거나, 열이 하루 넘게 지속되거나, 걱정된다면 의사에게 연락하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Isso é febre. Ligue para o médico se o bebê parecer doente, se a febre durar mais de um dia ou se você estiver preocupado."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "宝宝发烧了。如果宝宝精神不好、发烧超过一天，或者你感到担心，请联系医生。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "寶寶發燒了。如果寶寶看起來不舒服、發燒超過一天，或你感到擔心，請聯絡醫師。"
          }
        }
      }
    },
