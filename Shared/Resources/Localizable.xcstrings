    "Tap a baby to switch to them. Every tab shows the selected baby.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe auf ein Baby, um zu ihm zu wechseln. Alle Tabs zeigen das ausgewählte Baby."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap a baby to switch to them. Every tab shows the selected baby."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca un bebé para cambiar a él. Todas las pestañas muestran el bebé seleccionado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez un bébé pour passer à lui. Tous les onglets affichent le bébé sélectionné."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "赤ちゃんをタップすると切り替わります。すべてのタブに選択中の赤ちゃんが表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아기를 탭하면 전환됩니다. 모든 탭에 선택한 아기가 표시됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque em um bebê para mudar para ele. Todas as abas mostram o bebê selecionado."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点击宝宝即可切换。所有标签页都会显示当前选中的宝宝。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "點一下寶寶即可切換。所有分頁都會顯示目前選取的寶寶。"
          }
        }
      }
    },
