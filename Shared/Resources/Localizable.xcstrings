    "Only entries with an end time count towards minutes.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur Einträge mit Endzeit zählen zu den Minuten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only entries with an end time count towards minutes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo cuentan los registros con hora de fin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seules les entrées avec une heure de fin sont comptées."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "終了時刻のある記録だけが時間に含まれます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "종료 시간이 있는 기록만 시간에 포함돼요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Só contam os registros com horário de término."
