    "All entries for this baby will be deleted from every device and from anyone you shared with. This cannot be undone.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle Einträge dieses Babys werden auf all deinen Geräten und bei allen, mit denen du es teilst, gelöscht. Das kann nicht widerrufen werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All entries for this baby will be deleted from every device and from anyone you shared with. This cannot be undone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos los registros de este bebé se eliminarán de todos tus dispositivos y de las personas con quienes lo compartiste. Esta acción no se puede deshacer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Toutes les entrées de ce bébé seront supprimées de tous les appareils et pour toutes les personnes avec qui vous les partagez. Cette action est irréversible."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この赤ちゃんのすべての記録が、すべてのデバイスと共有相手から削除されます。この操作は取り消せません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 아기의 모든 기록이 내 모든 기기와 공유한 모든 사람에게서 삭제돼요. 이 작업은 되돌릴 수 없어요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos os registros deste bebê serão apagados de todos os dispositivos e de todas as pessoas com quem você compartilhou. Não é possível desfazer."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该宝宝的所有记录将从你的所有设备以及所有共享成员处删除，且无法恢复。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這位寶寶的所有紀錄將從你的所有裝置，以及所有共享對象那裡刪除，且無法復原。"
          }
        }
      }
    },
    "All of Tinytide’s actions are also in the Shortcuts app, for automations and the Action button.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle Aktionen von Tinytide gibt es auch in der Kurzbefehle-App, für Automationen und die Aktionstaste."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All of Tinytide’s actions are also in the Shortcuts app, for automations and the Action button."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todas las acciones de Tinytide también están en la app Atajos, para automatizaciones y el botón de Acción."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Toutes les actions de Tinytide sont aussi dans l’app Raccourcis, pour les automatisations et le bouton Action."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Tinytide のすべてのアクションはショートカットアプリにもあり、オートメーションやアクションボタンで使えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Tinytide의 모든 동작은 단축어 앱에도 있어서 자동화와 동작 버튼에 쓸 수 있어요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Todas as ações do Tinytide também estão no app Atalhos, para automações e o botão de Ação."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "摇摇的所有操作也都在“快捷指令”App 中，可用于自动化和操作按钮。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "搖搖的所有操作也都在「捷徑」App 中，可用於自動化和動作按鈕。"
          }
        }
      }
    },
