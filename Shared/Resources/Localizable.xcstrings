    "See daily trends and when the next nap is due, based on age and your baby's own rhythm.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sieh tägliche Trends und wann der nächste Schlaf fällig ist – nach Alter und dem eigenen Rhythmus deines Babys."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "See daily trends and when the next nap is due, based on age and your baby's own rhythm."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Consulta las tendencias diarias y cuándo toca la próxima siesta, según la edad y el ritmo de tu bebé."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Suivez les tendances du jour et l’heure de la prochaine sieste, selon l’âge et le rythme de votre bébé."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "毎日の傾向と、月齢や赤ちゃん自身のリズムにもとづく次のお昼寝の時間がわかります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "매일의 추이와, 월령과 아기만의 리듬에 맞춘 다음 낮잠 시간을 확인해요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Veja as tendências diárias e quando é a próxima soneca, com base na idade e no ritmo do seu bebê."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "查看每日趋势，并根据月龄和宝宝自己的作息预测下次小睡时间。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "查看每日趨勢，並根據月齡和寶寶自己的作息預測下次小睡時間。"
          }
        }
      }
    },
