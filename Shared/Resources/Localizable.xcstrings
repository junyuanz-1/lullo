    "%@ is shared with you to view only, so nothing was logged.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ wurde nur zum Ansehen mit dir geteilt, daher wurde nichts eingetragen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is shared with you to view only, so nothing was logged."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ se compartió contigo solo para ver, así que no se registró nada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ est partagé avec vous en lecture seule, rien n’a donc été noté."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ は閲覧のみで共有されているため、何も記録されませんでした。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@님은 보기 전용으로 공유되어 아무것도 기록되지 않았어요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ foi compartilhado com você apenas para visualização, então nada foi registrado."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 是以“仅查看”方式共享给你的，所以没有记录任何内容。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 是以「僅檢視」方式共享給你的，所以沒有記錄任何內容。"
          }
        }
      }
    },
