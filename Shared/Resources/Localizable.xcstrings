    "Medication reminders can be set when logging a dose.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erinnerungen an Medikamente kannst du beim Eintragen einer Dosis festlegen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Medication reminders can be set when logging a dose."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puedes configurar recordatorios de medicamentos al registrar una dosis."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les rappels de médicament se règlent lors de la saisie d’une dose."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "お薬の通知は、服用を記録するときに設定できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "투약을 기록할 때 다음 투약 알림을 설정할 수 있어요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você pode definir lembretes de medicamento ao registrar uma dose."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "记录用药时可以设置下次服药提醒。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "記錄用藥時可以設定下次用藥提醒。"
          }
        }
      }
    },
