    "Paused: the alarm continues when nursing resumes.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Pausiert: Der Wecker läuft weiter, sobald das Stillen weitergeht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Paused: the alarm continues when nursing resumes."
          }
        },
