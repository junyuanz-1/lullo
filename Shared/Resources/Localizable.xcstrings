    "Watch for hives, swelling, vomiting or trouble breathing. Call emergency services if breathing is affected.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Achte auf Nesselausschlag, Schwellungen, Erbrechen oder Atemprobleme. Ruf den Notruf, wenn die Atmung beeinträchtigt ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Watch for hives, swelling, vomiting or trouble breathing. Call emergency services if breathing is affected."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vigila si aparecen ronchas (urticaria), hinchazón, vómitos o dificultad para respirar. Si afecta a la respiración, llama a emergencias."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Surveillez l’apparition d’urticaire, d’un gonflement, de vomissements ou de difficultés à respirer. Appelez les secours si la respiration est touchée."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "じんましん、腫れ、嘔吐、呼吸が苦しそうな様子がないか注意してください。呼吸に影響がある場合は、すぐに救急車を呼んでください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "두드러기, 부기, 구토, 호흡 곤란이 있는지 잘 살펴보세요. 호흡에 문제가 생기면 즉시 119 등 응급 서비스에 연락하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Fique atento a urticária, inchaço, vômito ou dificuldade para respirar. Se a respiração for afetada, ligue para o serviço de emergência."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请留意荨麻疹、肿胀、呕吐或呼吸困难。如影响呼吸，请立即拨打急救电话。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請留意是否出現蕁麻疹、腫脹、嘔吐或呼吸困難。若影響到呼吸，請立即撥打緊急救護電話。"
          }
        }
      }
    },
