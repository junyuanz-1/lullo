    "Allow notifications for Tinytide in the Settings app to get reminders.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erlaube Mitteilungen für Tinytide in der Einstellungen-App, um Erinnerungen zu erhalten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow notifications for Tinytide in the Settings app to get reminders."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite las notificaciones de Tinytide en la app Ajustes para recibir recordatorios."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autorisez les notifications de Tinytide dans l’app Réglages pour recevoir les rappels."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リマインダーを受け取るには、設定アプリで Tinytide の通知を許可してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
