    "Start sleep, nursing or pumping with a tap. Timers keep running on the Lock Screen and Dynamic Island.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Starte Schlaf, Stillen oder Abpumpen mit einem Tipp. Timer laufen auf dem Sperrbildschirm und in der Dynamic Island weiter."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start sleep, nursing or pumping with a tap. Timers keep running on the Lock Screen and Dynamic Island."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicia sueño, lactancia o extracción con un toque. Los cronómetros siguen en la pantalla bloqueada y la Dynamic Island."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lancez sommeil, allaitement ou tire-lait d’un geste. Les chronos continuent sur l’écran verrouillé et dans la Dynamic Island."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タップひとつで睡眠・授乳・搾乳を開始。タイマーはロック画面とダイナミックアイランドで動き続けます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "탭 한 번으로 수면, 수유, 유축을 시작해요. 타이머는 잠금 화면과 Dynamic Island에서 계속 돌아가요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicie sono, amamentação ou extração com um toque. Os cronômetros continuam na Tela Bloqueada e na Dynamic Island."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点一下即可开始睡眠、亲喂或吸奶计时，计时会持续显示在锁屏和灵动岛上。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "點一下即可開始睡眠、親餵或擠奶計時，計時會持續顯示在鎖定畫面和動態島上。"
          }
        }
      }
    },
