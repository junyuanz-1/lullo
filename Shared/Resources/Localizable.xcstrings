          "stringUnit": {
            "state": "translated",
            "value": "睡眠を記録すると、月齢と赤ちゃんのリズムにもとづいてお昼寝の時間を提案します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "수면을 기록하면 월령과 아기의 리듬에 맞춰 낮잠 시간을 추천해 드려요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Registre um sono para receber sugestões de soneca com base na idade e no ritmo do seu bebê."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "记录一次睡眠后，这里会根据月龄和宝宝的作息推荐小睡时间。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "記錄一次睡眠後，這裡會根據月齡和寶寶的作息推薦小睡時間。"
          }
        }
      }
    },
