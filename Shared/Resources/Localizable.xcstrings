    "Starts a breastfeeding timer on the given side, or the suggested side.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Startet einen Stilltimer auf der angegebenen oder der empfohlenen Seite."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Starts a breastfeeding timer on the given side, or the suggested side."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicia un cronómetro de lactancia en el lado indicado o en el lado sugerido."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lance un chronomètre de tétée du côté indiqué, ou du côté suggéré."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "指定した側（または提案された側）で授乳タイマーを開始します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지정한 쪽 또는 추천 쪽으로 모유 수유 타이머를 시작해요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicia o cronômetro de amamentação no lado escolhido ou no lado sugerido."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在指定一侧（或建议的一侧）开始亲喂计时。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在指定的一側（或建議的一側）開始親餵計時。"
          }
        }
      }
    },
    "Starts a sleep timer.": {
