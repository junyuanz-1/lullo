    "Based on age and this baby's recent wake windows.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Basierend auf dem Alter und den letzten Wachphasen deines Babys."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Based on age and this baby's recent wake windows."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Según la edad y las ventanas de vigilia recientes de tu bebé."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "D’après l’âge et les dernières périodes d’éveil de ce bébé."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "月齢と、この赤ちゃんの最近の活動時間をもとに予測しています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "월령과 이 아기의 최근 깨어 있는 시간을 기준으로 해요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Com base na idade e nas janelas de sono recentes deste bebê."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "根据月龄和宝宝最近的清醒时长推算。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "根據月齡和寶寶最近的清醒時長推算。"
          }
        }
      }
    },
    "Based on typical wake windows for this age.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Basierend auf typischen Wachphasen in diesem Alter."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Based on typical wake windows for this age."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Según las ventanas de vigilia habituales para esta edad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "D’après les périodes d’éveil habituelles à cet âge."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この月齢の一般的な活動時間をもとに予測しています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 월령의 일반적인 깨어 있는 시간을 기준으로 해요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Com base nas janelas de sono típicas desta idade."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "根据该月龄的典型清醒时长推算。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "根據這個月齡的一般清醒時長推算。"
          }
        }
      }
    },
