    "Your data is stored in your private iCloud database and backed up automatically. On a new iPhone, sign in with the same Apple ID and install the app: everything downloads automatically.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Daten werden in deiner privaten iCloud-Datenbank gespeichert und automatisch gesichert. Melde dich auf einem neuen iPhone mit derselben Apple-ID an und installiere die App: Alles wird automatisch geladen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your data is stored in your private iCloud database and backed up automatically. On a new iPhone, sign in with the same Apple ID and install the app: everything downloads automatically."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus datos se guardan en tu base de datos privada de iCloud y se respaldan automáticamente. En un iPhone nuevo, inicia sesión con el mismo Apple ID e instala la app: todo se descarga automáticamente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos données sont stockées dans votre base de données iCloud privée et sauvegardées automatiquement. Sur un nouvel iPhone, connectez-vous avec le même identifiant Apple et installez l’app : tout se télécharge automatiquement."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "データはあなた専用のiCloudデータベースに保存され、自動的にバックアップされます。新しいiPhoneでは、同じApple IDでサインインしてAppをインストールするだけで、すべてのデータが自動的にダウンロードされます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "데이터는 비공개 iCloud 데이터베이스에 저장되고 자동으로 백업돼요. 새 iPhone에서 같은 Apple ID로 로그인하고 앱을 설치하면 모든 데이터가 자동으로 다운로드돼요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seus dados ficam no seu banco de dados privado do iCloud, com backup automático. Em um iPhone novo, inicie sessão com o mesmo Apple ID e instale o app: tudo é baixado automaticamente."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的数据保存在私人 iCloud 数据库中并自动备份。换新 iPhone 时，登录同一个 Apple ID 并安装本 App，所有数据会自动下载。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你的資料儲存在你私人的 iCloud 資料庫中，並會自動備份。換新 iPhone 時，只要登入同一個 Apple ID 並安裝本 App，所有資料就會自動下載。"
          }
        }
      }
    },
    "Your data now matches the backup from %@.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Daten entsprechen jetzt dem Backup vom %@."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your data now matches the backup from %@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus datos ahora coinciden con la copia del %@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos données correspondent maintenant à la sauvegarde du %@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ のバックアップの状態に戻りました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 백업 상태로 복원되었어요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seus dados agora correspondem ao backup de %@."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "数据已恢复到 %@ 的备份。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "資料已還原到 %@ 的備份。"
          }
        }
      }
    },
    "Your data now matches the backup from %@. Babies shared with you as view-only were not changed.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Daten entsprechen jetzt dem Backup vom %@. Babys, die nur zum Ansehen mit dir geteilt sind, wurden nicht geändert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your data now matches the backup from %@. Babies shared with you as view-only were not changed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus datos ahora coinciden con la copia del %@. Los bebés compartidos contigo solo para ver no se cambiaron."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos données correspondent maintenant à la sauvegarde du %@. Les bébés partagés avec vous en lecture seule n’ont pas été modifiés."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ のバックアップの状態に戻りました。閲覧のみで共有されている赤ちゃんは変更されていません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 백업 상태로 복원되었어요. 보기 전용으로 공유받은 아기는 바뀌지 않았어요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seus dados agora correspondem ao backup de %@. Bebês compartilhados com você apenas para visualização não foram alterados."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "数据已恢复到 %@ 的备份。别人以“仅查看”方式共享给你的宝宝没有改动。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "資料已還原到 %@ 的備份。別人以「僅檢視」方式分享給你的寶寶沒有變動。"
          }
        }
      }
    },
