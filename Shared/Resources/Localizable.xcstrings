    "Starts a timer. Touch and hold for more options.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Startet einen Timer. Gedrückt halten für weitere Optionen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Starts a timer. Touch and hold for more options."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicia un cronómetro. Mantén pulsado para más opciones."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Démarre un chrono. Touchez longuement pour plus d’options."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タイマーを開始します。長押しでその他のオプション。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "타이머를 시작해요. 길게 누르면 더 많은 옵션이 있어요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicia um cronômetro. Toque e segure para mais opções."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开始计时。长按查看更多选项。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開始計時。長按查看更多選項。"
          }
        }
      }
    },
