    "Running timers show on the Lock Screen and in the Dynamic Island. Stop them, pause, or switch nursing sides without unlocking.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Laufende Timer erscheinen auf dem Sperrbildschirm und in der Dynamic Island. Stoppen, pausieren oder die Seite wechseln – ohne zu entsperren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Running timers show on the Lock Screen and in the Dynamic Island. Stop them, pause, or switch nursing sides without unlocking."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los cronómetros en marcha aparecen en la pantalla bloqueada y en la Dynamic Island. Detenlos, pausa o cambia de lado sin desbloquear."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les chronos en cours s’affichent sur l’écran verrouillé et dans la Dynamic Island. Arrêtez, mettez en pause ou changez de côté sans déverrouiller."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "実行中のタイマーはロック画面とダイナミックアイランドに表示されます。ロックを解除せずに停止・一時停止・授乳の左右切り替えができます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "실행 중인 타이머가 잠금 화면과 Dynamic Island에 표시돼요. 잠금을 풀지 않고 중지, 일시 정지하거나 수유 방향을 바꿀 수 있어요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os cronômetros em andamento aparecem na Tela Bloqueada e na Dynamic Island. Pare, pause ou troque o lado sem desbloquear."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在进行的计时会显示在锁屏和灵动岛上。不用解锁就能停止、暂停或切换喂奶侧。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "進行中的計時會顯示在鎖定畫面和動態島上。不用解鎖就能停止、暫停或切換餵奶側。"
          }
        }
      }
    },
