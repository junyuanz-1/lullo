    "A temperature of 38 °C (100.4 °F) or higher in a baby under 3 months needs prompt medical attention. Call your doctor now.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Temperatur von 38 °C (100.4 °F) oder höher bei einem Baby unter 3 Monaten muss umgehend ärztlich abgeklärt werden. Ruf jetzt einen Arzt an."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A temperature of 38 °C (100.4 °F) or higher in a baby under 3 months needs prompt medical attention. Call your doctor now."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En un bebé menor de 3 meses, una temperatura de 38 °C (100.4 °F) o más requiere atención médica inmediata. Llama a tu médico ahora."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chez un bébé de moins de 3 mois, une température de 38 °C (100.4 °F) ou plus nécessite un avis médical rapide. Appelez votre médecin dès maintenant."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "生後3か月未満の赤ちゃんで体温が38 °C (100.4 °F)以上の場合は、すみやかな受診が必要です。今すぐ医師に連絡してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "생후 3개월 미만 아기의 체온이 38 °C (100.4 °F) 이상이면 신속한 진료가 필요해요. 지금 바로 의사에게 연락하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Temperatura de 38 °C (100.4 °F) ou mais em bebês com menos de 3 meses exige atendimento médico imediato. Ligue para o médico agora."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "3 个月以下的宝宝体温达到 38 °C（100.4 °F）或更高，需要尽快就医。请立即联系医生。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "未滿 3 個月的寶寶體溫達 38 °C（100.4 °F）或以上時，需要盡快就醫。請立即聯絡醫師。"
          }
        }
      }
    },
