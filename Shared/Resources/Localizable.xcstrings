    "Today is still in progress: it is shown faded in the charts and left out of the averages.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Heute läuft noch: Der Tag ist in den Diagrammen blasser und zählt nicht zu den Durchschnitten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Today is still in progress: it is shown faded in the charts and left out of the averages."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoy aún no ha terminado: se muestra atenuado en los gráficos y no cuenta en los promedios."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aujourd’hui n’est pas terminé : il est estompé dans les graphiques et exclu des moyennes."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今日はまだ途中のため、グラフでは薄く表示され、平均には含まれません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오늘은 아직 진행 중이라 차트에 흐리게 표시되고 평균에서 제외돼요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoje ainda está em andamento: aparece esmaecido nos gráficos e fica fora das médias."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "今天还没结束：图表中以淡色显示，且不计入平均值。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "今天還沒結束：圖表中以淡色顯示，且不計入平均值。"
          }
        }
      }
    },
