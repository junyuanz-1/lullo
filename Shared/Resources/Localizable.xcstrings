            "state": "translated",
            "value": "Touch and Hold for More"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén pulsado para más"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez longuement pour plus"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "長押しでその他の操作"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "길게 눌러 더 보기"
          }
        },
        "pt-BR": {
          "stringUnit": {
