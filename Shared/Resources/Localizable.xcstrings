    "Daily patterns appear here once you start logging sleep, feeds and diapers.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tägliche Muster erscheinen hier, sobald du Schlaf, Mahlzeiten und Windeln einträgst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Daily patterns appear here once you start logging sleep, feeds and diapers."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los patrones diarios aparecerán aquí cuando empieces a registrar sueño, tomas y pañales."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les tendances quotidiennes apparaîtront ici dès que vous noterez sommeil, repas et couches."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "睡眠・授乳・おむつを記録し始めると、ここに毎日のパターンが表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "수면, 수유, 기저귀를 기록하기 시작하면 여기에 매일의 패턴이 표시돼요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os padrões diários aparecem aqui quando você começar a registrar sono, mamadas e fraldas."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开始记录睡眠、喂奶和尿布后，这里会显示每天的规律。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開始記錄睡眠、餵奶和尿布後，這裡會顯示每天的規律。"
          }
        }
      }
    },
