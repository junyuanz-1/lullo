    "Rings with a gentle sound. Choose the sound in More → Timer Alarm.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Klingelt mit einem sanften Ton. Wähle den Ton unter Mehr → Timer-Wecker."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rings with a gentle sound. Choose the sound in More → Timer Alarm."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Suena con un sonido suave. Elige el sonido en Más → Alarma del temporizador."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sonne avec un son doux. Choisissez le son dans Plus → Alarme du minuteur."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "やさしい音でお知らせします。サウンドは「その他 → タイマーアラーム」で選べます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "부드러운 소리로 알려줘요. 소리는 더 보기 → 타이머 알람에서 고를 수 있어요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca com um som suave. Escolha o som em Mais → Alarme do timer."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "会用柔和的声音提醒。可在“更多 → 计时闹钟”中选择声音。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "會用柔和的聲音提醒。可在「更多 → 計時鬧鐘」中選擇聲音。"
          }
        }
      }
    },
    "Rings with a gentle sound. Choose the sound in Settings → Timer Alarm.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Klingelt mit einem sanften Ton. Den Ton wählst du unter Einstellungen → Timer-Wecker."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rings with a gentle sound. Choose the sound in Settings → Timer Alarm."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Suena con un tono suave. Elige el sonido en Ajustes → Alarma del temporizador."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sonne avec un son doux. Choisissez-le dans Réglages → Alarme du minuteur."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "やさしい音で鳴ります。音は 設定 → タイマーアラーム で選べます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "부드러운 소리로 울려요. 설정 → 타이머 알람에서 소리를 고를 수 있어요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca com um som suave. Escolha o som em Ajustes → Alarme do timer."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "响铃声音很轻柔。可以在 设置 → 计时闹钟 中选择铃声。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "響鈴聲音很輕柔。可以在 設定 → 計時鬧鐘 中選擇鈴聲。"
          }
        }
      }
    },
