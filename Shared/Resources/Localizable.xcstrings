        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud 同步"
          }
        }
      }
    },
    "iCloud hasn't finished downloading this iPhone's data yet. Importing now may add a second copy of a baby that is still on its way.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud hat die Daten dieses iPhones noch nicht vollständig geladen. Ein Import jetzt kann ein Baby doppelt anlegen, das gerade noch ankommt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud hasn't finished downloading this iPhone's data yet. Importing now may add a second copy of a baby that is still on its way."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud aún no ha terminado de descargar los datos de este iPhone. Si importas ahora, podría duplicarse un bebé que todavía está llegando."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud n’a pas fini de télécharger les données de cet iPhone. Importer maintenant peut créer un doublon d’un bébé encore en cours de synchronisation."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud はこの iPhone のデータをまだダウンロードし終えていません。今読み込むと、同期中の赤ちゃんが重複する可能性があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud가 아직 이 iPhone의 데이터를 다 내려받지 못했어요. 지금 가져오면 동기화 중인 아기가 중복될 수 있어요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O iCloud ainda não terminou de baixar os dados deste iPhone. Importar agora pode criar uma cópia extra de um bebê que ainda está chegando."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud 还没把这台 iPhone 的数据下载完。现在导入可能会多出一份正在同步中的宝宝。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud 還沒把這台 iPhone 的資料下載完。現在匯入可能會多出一份正在同步中的寶寶。"
          }
        }
      }
    },
    "iCloud hasn't finished downloading this iPhone's data yet. Restoring now may add a second copy of a baby that is still on its way.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud hat die Daten dieses iPhones noch nicht vollständig geladen. Eine Wiederherstellung jetzt kann ein Baby doppelt anlegen, das gerade noch ankommt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud hasn't finished downloading this iPhone's data yet. Restoring now may add a second copy of a baby that is still on its way."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud aún no ha terminado de descargar los datos de este iPhone. Si restauras ahora, podría duplicarse un bebé que todavía está llegando."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud n’a pas fini de télécharger les données de cet iPhone. Restaurer maintenant peut créer un doublon d’un bébé encore en cours de synchronisation."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud はこの iPhone のデータをまだダウンロードし終えていません。今復元すると、同期中の赤ちゃんが重複する可能性があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud가 아직 이 iPhone의 데이터를 다 내려받지 못했어요. 지금 복원하면 동기화 중인 아기가 중복될 수 있어요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O iCloud ainda não terminou de baixar os dados deste iPhone. Restaurar agora pode criar uma cópia extra de um bebê que ainda está chegando."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud 还没把这台 iPhone 的数据下载完。现在恢复可能会多出一份正在同步中的宝宝。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud 還沒把這台 iPhone 的資料下載完。現在回復可能會多出一份正在同步中的寶寶。"
          }
        }
      }
    },
