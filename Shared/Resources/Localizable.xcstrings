    "On Today, touch and hold a timer to pick a nursing side, add details before starting, or log one from earlier.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Halte unter „Heute“ einen Timer gedrückt, um eine Stillseite zu wählen, vor dem Start Details hinzuzufügen oder etwas nachzutragen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On Today, touch and hold a timer to pick a nursing side, add details before starting, or log one from earlier."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En Hoy, mantén pulsado un cronómetro para elegir el lado, añadir detalles antes de empezar o registrar uno anterior."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dans Aujourd’hui, touchez longuement un chrono pour choisir le côté, ajouter des détails avant de démarrer ou noter une entrée passée."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「今日」でタイマーを長押しすると、授乳の左右を選んだり、詳細を入力してから開始したり、あとから記録したりできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오늘 화면에서 타이머를 길게 누르면 수유 방향을 고르거나, 세부 정보를 입력하고 시작하거나, 지난 기록을 추가할 수 있어요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Em Hoje, toque e segure um cronômetro para escolher o lado, adicionar detalhes antes de começar ou registrar um anterior."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在“今天”页长按计时按钮，可以选择喂奶侧、填写详情后再开始，或补录之前的记录。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在「今天」頁長按計時按鈕，可以選擇餵奶側、填寫詳情後再開始，或補登之前的紀錄。"
          }
        }
      }
    },
