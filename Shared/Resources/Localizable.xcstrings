    "Stop it or switch sides from the Lock Screen or Dynamic Island. Add a Tinytide widget to your Home Screen for one-tap logging.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stoppe ihn oder wechsle die Seite auf dem Sperrbildschirm oder in der Dynamic Island. Mit einem Tinytide-Widget auf dem Home-Bildschirm trägst du mit einem Tipp ein."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stop it or switch sides from the Lock Screen or Dynamic Island. Add a Tinytide widget to your Home Screen for one-tap logging."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Detenlo o cambia de lado desde la pantalla bloqueada o la Dynamic Island. Añade un widget de Tinytide a la pantalla de inicio para registrar con un toque."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrêtez-le ou changez de côté depuis l’écran verrouillé ou la Dynamic Island. Ajoutez un widget Tinytide à l’écran d’accueil pour noter en un geste."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ロック画面やダイナミックアイランドから停止や左右の切り替えができます。ホーム画面に Tinytide ウィジェットを追加すると、ワンタップで記録できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "잠금 화면이나 Dynamic Island에서 중지하거나 방향을 바꿀 수 있어요. 홈 화면에 Tinytide 위젯을 추가하면 한 번에 기록할 수 있어요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pare ou troque o lado na Tela Bloqueada ou na Dynamic Island. Adicione um widget do Tinytide à Tela de Início para registrar com um toque."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可以在锁屏或灵动岛上停止计时或切换喂奶侧。把“摇摇”小组件添加到主屏幕，一键就能记录。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "可以在鎖定畫面或動態島上停止計時或切換餵奶側。把「搖搖」小工具加入主畫面，一鍵就能記錄。"
          }
        }
      }
    },
    "Stops the running breastfeeding timer.": {
