    "Time since the last feed, diaper and sleep, with quick logging buttons.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeit seit der letzten Mahlzeit, Windel und dem letzten Schlaf – mit Schnelltasten zum Eintragen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Time since the last feed, diaper and sleep, with quick logging buttons."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiempo desde la última toma, el último pañal y el último sueño, con botones de registro rápido."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Temps écoulé depuis le dernier repas, la dernière couche et le dernier sommeil, avec des boutons de saisie rapide."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "前回の授乳・おむつ替え・睡眠からの経過時間と、すばやく記録できるボタンを表示します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "마지막 수유, 기저귀, 수면 이후 지난 시간과 빠른 기록 버튼을 보여 줘요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tempo desde a última mamada, fralda e sono, com botões de registro rápido."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "显示距上次喂奶、换尿布和睡眠的时间，并提供快捷记录按钮。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "顯示距離上次餵奶、換尿布和睡眠的時間，並提供快速記錄按鈕。"
          }
        }
      }
    },
