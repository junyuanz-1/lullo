    "Helps keep Tinytide ad-free.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hilft, Tinytide werbefrei zu halten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Helps keep Tinytide ad-free."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayuda a que Tinytide siga sin anuncios."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aide Tinytide à rester sans publicité."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Tinytideの広告なし運営を支えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Tinytide가 광고 없이 운영되도록 도와줘요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
