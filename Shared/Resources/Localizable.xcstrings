    "Say a time between 1 minute and 12 hours ago.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenne eine Zeit zwischen 1 Minute und 12 Stunden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Say a time between 1 minute and 12 hours ago."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Di un tiempo entre 1 minuto y 12 horas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Indiquez une durée entre 1 minute et 12 heures."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1分前から12時間前までの時間を言ってください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "1분에서 12시간 사이로 말해 주세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Diga um tempo entre 1 minuto e 12 horas."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请说 1 分钟到 12 小时之间的时间。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請說 1 分鐘到 12 小時之間的時間。"
          }
        }
      }
    },
    "Say “Start sleep in Tinytide”, “Baby woke up in Tinytide” or “Log a diaper in Tinytide”.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sag „Schlaf in Tinytide starten“, „Baby ist wach in Tinytide“ oder „Windel in Tinytide eintragen“."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Say “Start sleep in Tinytide”, “Baby woke up in Tinytide” or “Log a diaper in Tinytide”."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Di «Inicia el sueño en Tinytide», «El bebé se despertó en Tinytide» o «Registra un pañal en Tinytide»."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dites « Démarrer le sommeil dans Tinytide », « Noter le réveil de bébé dans Tinytide » ou « Noter une couche dans Tinytide »."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「Tinytideで睡眠を開始」「Tinytideで赤ちゃんが起きた」「Tinytideでおむつを記録」のように話しかけてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "“Tinytide에서 수면 시작”, “Tinytide에서 아기가 깼어요”, “Tinytide에서 기저귀 기록”이라고 말해 보세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Diga “Iniciar sono no Tinytide”, “Bebê acordou no Tinytide” ou “Registrar fralda no Tinytide”."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可以说“用摇摇开始睡眠”“摇摇宝宝醒了”或“用摇摇记录尿布”。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "可以說「用搖搖開始睡眠」「搖搖寶寶醒了」或「用搖搖記錄尿布」。"
          }
        }
      }
    },
