    "Could not start sharing. Make sure you are signed in to iCloud. (%@)": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Teilen konnte nicht gestartet werden. Stelle sicher, dass du bei iCloud angemeldet bist. (%@)"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not start sharing. Make sure you are signed in to iCloud. (%@)"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo empezar a compartir. Asegúrate de haber iniciado sesión en iCloud. (%@)"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de démarrer le partage. Vérifiez que vous êtes connecté à iCloud. (%@)"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "共有を開始できませんでした。iCloudにサインインしているか確認してください。（%@）"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "공유를 시작할 수 없어요. iCloud에 로그인되어 있는지 확인하세요. (%@)"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível iniciar o compartilhamento. Verifique se você iniciou sessão no iCloud. (%@)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法开始共享，请确认已登录 iCloud。（%@）"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法開始共享，請確認你已登入 iCloud。（%@）"
          }
        }
      }
    },
