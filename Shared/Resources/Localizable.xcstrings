    "Set your baby's sex in the profile to compare with WHO growth standards.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lege im Profil das Geschlecht deines Babys fest, um mit den WHO-Wachstumsstandards zu vergleichen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Set your baby's sex in the profile to compare with WHO growth standards."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Indica el sexo de tu bebé en su perfil para compararlo con los patrones de crecimiento de la OMS."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Indiquez le sexe de votre bébé dans son profil pour comparer avec les normes de croissance de l’OMS."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プロフィールで赤ちゃんの性別を設定すると、WHOの成長基準と比較できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "WHO 성장 표준과 비교하려면 프로필에서 아기의 성별을 설정하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Defina o sexo do bebê no perfil para comparar com os padrões de crescimento da OMS."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在宝宝资料中设置性别后，即可与 WHO 生长标准对比。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在寶寶的個人資料中設定性別後，即可與 WHO 生長標準比較。"
          }
        }
      }
    },
