default_platform(:ios)

platform :ios do
  desc "Capture App Store screenshots for every language (see Snapfile)"
  lane :screenshots do
    capture_screenshots
  end

  desc "Upload fastlane/screenshots to App Store Connect, replacing the current ones"
  desc "Needs an App Store Connect API key: see fastlane/README.md"
  lane :upload_screenshots do
    deliver(
      api_key_path: ENV.fetch("ASC_API_KEY_PATH", "fastlane/asc_api_key.json"),
      skip_binary_upload: true,
      skip_metadata: true,
      skip_app_version_update: true,
      overwrite_screenshots: true,
      force: true,
      run_precheck_before_submit: false
    )
  end
end
